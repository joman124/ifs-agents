# Inner Table - server settings. Set these in Vercel -> Settings ->
# Environment Variables (Production and Preview), or pull them locally with
# `vercel env pull .env.local`. Never commit real values.
#
# Settings -> Free AI setup (for accounts in STATS_USERS) checks the free AI
# settings below against the provider FREELLMAPI_URL points at, and says
# which one is wrong and what to set instead. See docs/free-ai.md.

# ---------------- accounts (needed by sync, the bridge and the free AI) ----------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SESSION_SECRET=

# ---------------- whoever runs the deployment ----------------
# Comma-separated usernames who see Settings -> Usage and Free AI setup.
STATS_USERS=
# Bearer for scripts and Vercel crons (/api/stats, /api/free-ai?check=1, reminders).
CRON_SECRET=

# ---------------- push reminders ----------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---------------- free AI ----------------
# Leave FREELLMAPI_URL and FREELLMAPI_KEY unset to switch the free AI off.
# Pick ONE of the three setups below.
#
# A) A FreeLLMAPI gateway (most room: it spreads requests over many providers)
#    FREELLMAPI_URL   = the gateway's bare address, with or without /v1,
#                       e.g. https://freellmapi-production-1234.up.railway.app
#                       (never ending in /chat/completions - that is added)
#    FREELLMAPI_KEY   = its unified key, freellmapi-...
#    FREELLMAPI_MODEL = optional. Models, routing strategies (auto:reliable,
#                       auto:smart) or profiles (auto:<name>), comma-separated,
#                       tried in order; the gateway's "auto" is always last.
#
# B) Groq directly
#    FREELLMAPI_URL   = https://api.groq.com/openai/v1
#    FREELLMAPI_KEY   = a key from console.groq.com/keys (starts gsk_)
#    FREELLMAPI_MODEL = optional - best left unset. Groq has no "auto"; its
#                       free models are tried anyway, in this order:
#                       meta-llama/llama-4-scout-17b-16e-instruct,
#                       llama-3.3-70b-versatile, openai/gpt-oss-120b,
#                       openai/gpt-oss-20b
#                       Gemini models named here get a 404 from Groq.
#
# C) Google's Gemini API directly
#    FREELLMAPI_URL   = https://generativelanguage.googleapis.com/v1beta/openai
#    FREELLMAPI_KEY   = a key from aistudio.google.com/apikey (starts AIza)
#    FREELLMAPI_MODEL = optional - best left unset. Gemini has no "auto"; its
#                       free models are tried anyway, in this order:
#                       gemini-3.5-flash, gemini-2.5-flash,
#                       gemini-2.5-flash-lite, gemma-4-31b-it,
#                       gemma-4-26b-a4b-it
#                       Groq models named here get a 404 from Gemini.
#                       Unpaid, Google may use what is sent to improve its
#                       products (see docs/free-ai.md, step 2).
FREELLMAPI_URL=
FREELLMAPI_KEY=
FREELLMAPI_MODEL=
# Messages per account per UTC day: a whole number, 0 for no cap. Default 500.
FREE_AI_DAILY_LIMIT=
# 1 lets Settings -> Free AI setup send each model one tiny fixed request
# ("Say OK.", no one's content) to see which answer. Off when unset.
FREE_AI_LIVE_CHECK=
