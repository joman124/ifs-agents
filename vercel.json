{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "app",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/bridge.js": {
      "includeFiles": "app/js/**"
    }
  },
  "rewrites": [
    {
      "source": "/connect/openrouter/:state",
      "destination": "/api/ai-key?state=:state"
    }
  ]
}
