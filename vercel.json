{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "app",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/bridge.js": {
      "includeFiles": "app/js/**"
    }
  },
  "rewrites": [
    {
      "source": "/connect/openrouter/:state",
      "destination": "/api/ai-key?state=:state"
    }
  ],
  "crons": [
    {
      "path": "/api/push-remind?h=0",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/push-remind?h=1",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/push-remind?h=2",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/push-remind?h=3",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/push-remind?h=4",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/push-remind?h=5",
      "schedule": "0 5 * * *"
    },
    {
